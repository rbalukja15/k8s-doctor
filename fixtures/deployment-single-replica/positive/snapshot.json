{
  "schemaVersion": "v1alpha1",
  "mode": "manifest",
  "source": {
    "path": "fixtures/deployment-single-replica/positive"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "payments",
        "namespace": "shop",
        "labels": {
          "app": "payments"
        },
        "replicas": 1,
        "selector": {
          "app": "payments"
        },
        "template": {
          "labels": {
            "app": "payments"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "api",
                "image": "ghcr.io/acme/api:1.4.2",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "emails",
        "namespace": "shop",
        "labels": {
          "app": "emails"
        },
        "selector": {
          "app": "emails"
        },
        "template": {
          "labels": {
            "app": "emails"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "api",
                "image": "ghcr.io/acme/api:1.4.2",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "pricing",
        "namespace": "shop",
        "labels": {
          "app": "pricing"
        },
        "replicas": 1,
        "selector": {
          "app": "pricing"
        },
        "template": {
          "labels": {
            "app": "pricing"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "api",
                "image": "ghcr.io/acme/api:1.4.2",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "horizontalPodAutoscalers": [
      {
        "apiVersion": "autoscaling/v2",
        "name": "pricing",
        "namespace": "shop",
        "targetRef": {
          "kind": "Deployment",
          "name": "pricing"
        },
        "maxReplicas": 5,
        "metrics": [
          {
            "type": "Resource",
            "resource": "cpu",
            "target": "Utilization"
          }
        ]
      }
    ]
  }
}
