{
  "schemaVersion": "v1alpha1",
  "mode": "manifest",
  "source": {
    "path": "fixtures/probe-readiness-missing/positive"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "orders",
        "namespace": "shop",
        "labels": {
          "app": "orders"
        },
        "replicas": 2,
        "selector": {
          "app": "orders"
        },
        "template": {
          "labels": {
            "app": "orders"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "app",
                "image": "ghcr.io/acme/api:1.4.2",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              },
              {
                "name": "metrics",
                "image": "quay.io/prometheus/statsd-exporter:v0.27.1",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/metrics",
                  "port": "9102",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "kind": "StatefulSet",
        "apiVersion": "apps/v1",
        "name": "cache",
        "namespace": "shop",
        "labels": {
          "app": "cache"
        },
        "replicas": 2,
        "selector": {
          "app": "cache"
        },
        "template": {
          "labels": {
            "app": "cache"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "redis",
                "image": "docker.io/library/redis:7.4.1",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
