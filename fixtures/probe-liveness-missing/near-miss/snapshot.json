{
  "schemaVersion": "v1alpha1",
  "mode": "manifest",
  "source": {
    "path": "fixtures/probe-liveness-missing/near-miss"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "legacy",
        "namespace": "shop",
        "labels": {
          "app": "legacy"
        },
        "replicas": 2,
        "selector": {
          "app": "legacy"
        },
        "template": {
          "labels": {
            "app": "legacy"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "app",
                "image": "ghcr.io/acme/api:1.4.2",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "startupProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                }
              }
            ]
          }
        }
      },
      {
        "kind": "CronJob",
        "apiVersion": "batch/v1",
        "name": "backup",
        "namespace": "shop",
        "labels": {
          "app": "backup"
        },
        "template": {
          "labels": {
            "app": "backup"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "backup",
                "image": "ghcr.io/acme/backup:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
