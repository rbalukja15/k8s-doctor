      "kind": "CronJob",
      "metadata": {"name": "nightly", "namespace": "batch"},
      "spec": {
        "schedule": "0 3 * * *",
        "jobTemplate": {"spec": {"template": {"spec": {
          "restartPolicy": "OnFailure",
          "containers": [{"name": "report", "image": "ghcr.io/acme/report:2.0.1"}]
        }}}}
      }
    },
    {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "batch"}}
  ]
}
